// =============================================================================
// Prisma Schema — Europe Study & Career Intelligence Portal
// =============================================================================
//
// IMPORTANT — Prisma 7 project configuration:
//
//   - The database connection URL is NOT defined here.
//     It is defined in prisma.config.ts, which the Prisma CLI reads.
//
//   - At runtime, the application connects via @prisma/adapter-pg (see lib/db.ts),
//     which uses the pooled DATABASE_URL environment variable directly.
//
//   - The datasource block here only declares the provider so the schema
//     parser knows this is a PostgreSQL schema.
//
// Generator:
//   - provider = "prisma-client" is the Prisma 7 Rust-free, ESM client.
//     (The legacy "prisma-client-js" is still supported but deprecated.)
//   - output points to a project-local directory so generated types are
//     visible to file watchers and dev tools without restarting.
//
// Schema evolution:
//   - Slice 2 adds public country/source metadata.
//   - SQL migrations additionally enforce CHECK constraints and RLS policies.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/client"
}

datasource db {
  // Provider declared here for schema validation.
  // The actual connection URL is supplied by prisma.config.ts (CLI)
  // or by the driver adapter in lib/db.ts (runtime).
  provider = "postgresql"
}

// Scope entries, not researched country profiles. Unknown metadata stays null.
model Country {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String   @unique
  isoCode   String?  @unique @map("iso_code")
  region    String?
  status    String   @default("needs_research")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  facts     Fact[]
  sources   Source[]
  universities University[]
  immigrationRules ImmigrationRule[]
  occupations Occupation[]

  // Slice 7: STORED generated full-text vector (read-only; see 20260926090000_search).
  searchVector Unsupported("tsvector")? @map("search_vector")
  @@index([searchVector], type: Gin, map: "countries_search_idx")
  @@map("countries")
}

model Source {
  documents      Document[]
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  canonicalUrl   String    @unique @map("canonical_url")
  countryId      String?   @map("country_id") @db.Uuid
  country        Country?  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  sourceTier     String?   @map("source_tier")
  sourceType     String?   @map("source_type")
  topics         String[]  @default([])
  language       String?
  authorityNotes String?   @map("authority_notes")
  status         String    @default("needs_verification")
  crawlEnabled   Boolean   @default(false) @map("crawl_enabled")
  crawlFrequency String?   @map("crawl_frequency")
  crawlPolicy    String    @default("not_reviewed") @map("crawl_policy")
  lastCrawledAt  DateTime? @map("last_crawled_at") @db.Timestamptz(6)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz(6)
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([countryId])
  @@index([sourceTier, status])
  // Slice 7: STORED generated full-text vector (read-only; see 20260926090000_search).
  searchVector Unsupported("tsvector")? @map("search_vector")
  @@index([searchVector], type: Gin, map: "sources_search_idx")
  @@map("sources")
}


// One immutable observation per source + URL + content hash. Changed content
// creates another row, preserving earlier metadata for later evidence links.
model Document {
  facts Fact[]
  evidence Evidence[]
  universities University[]
  programmes Programme[]
  immigrationRules ImmigrationRule[]
  occupations Occupation[]
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId         String   @map("source_id") @db.Uuid
  source           Source   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  canonicalUrl     String   @map("canonical_url")
  title            String?
  documentType     String   @default("unknown") @map("document_type")
  contentHash      String   @map("content_hash") @db.VarChar(64)
  hashMethod       String   @default("sha256-raw-v1") @map("hash_method")
  metadataHash     String   @map("metadata_hash") @db.VarChar(64)
  excerpt          String?
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  sourceUpdatedAt  DateTime? @map("source_updated_at") @db.Timestamptz(6)
  retrievedAt      DateTime @map("retrieved_at") @db.Timestamptz(6)
  ingestionMethod  String   @map("ingestion_method")
  processingStatus String   @default("stored") @map("processing_status")
  extractionStatus String   @default("not_started") @map("extraction_status")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sourceId, canonicalUrl, contentHash])
  @@index([sourceId, retrievedAt])
  @@index([createdAt, id])
  // Slice 7: STORED generated full-text vector (read-only; see 20260926090000_search).
  searchVector Unsupported("tsvector")? @map("search_vector")
  @@index([searchVector], type: Gin, map: "documents_search_idx")
  @@map("documents")
}

model Role {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String @unique
  description String @default("")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  permissions RolePermission[]
  users       UserRole[]
  @@map("roles")
}
model Permission {
  key         String @id
  description String
  roles       RolePermission[]
  @@map("permissions")
}
model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")
  role          Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)
  @@id([roleId, permissionKey])
  @@map("role_permissions")
}
model UserRole {
  // The SQL migration adds the FK to Supabase-owned auth.users. Prisma must not
  // generate or migrate Supabase's auth schema.
  userId    String @map("user_id") @db.Uuid
  roleId    String @map("role_id") @db.Uuid
  role      Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@id([userId, roleId])
  @@map("user_roles")
}
model AccessAudit {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId   String? @map("actor_id") @db.Uuid
  action    String
  targetId  String? @map("target_id") @db.Uuid
  // Variable audit snapshots, not the authoritative relational permission store.
  details   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([createdAt])
  @@map("access_audit")
}


model Fact {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String @map("document_id") @db.Uuid
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  topic String
  subject String
  predicate String
  value String
  unit String?
  countryId String? @map("country_id") @db.Uuid
  country Country? @relation(fields: [countryId], references: [id], onDelete: Restrict)
  validFrom DateTime? @map("valid_from") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date
  status String @default("proposed")
  createdBy String @map("created_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Slice 5/6a/6b: at most one linked entity (SQL CHECK facts_single_entity).
  universityId String? @map("university_id") @db.Uuid
  university University? @relation(fields: [universityId], references: [id], onDelete: Restrict)
  programmeId String? @map("programme_id") @db.Uuid
  programme Programme? @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  deadlineType String? @map("deadline_type")
  immigrationRuleId String? @map("immigration_rule_id") @db.Uuid
  immigrationRule ImmigrationRule? @relation(fields: [immigrationRuleId], references: [id], onDelete: Restrict)
  // Slice 6b: occupation-linked figures must have country_id (SQL CHECK facts_occupation_country).
  occupationId String? @map("occupation_id") @db.Uuid
  occupation Occupation? @relation(fields: [occupationId], references: [id], onDelete: Restrict)
  // Period a statistic measures: YYYY, YYYY-Qn, YYYY-Hn or YYYY-MM (SQL CHECK).
  referencePeriod String? @map("reference_period")
  // Slice 7: comparison metric; requires country_id (SQL CHECK facts_metric_country).
  metricId String? @map("metric_id") @db.Uuid
  metric ComparisonMetric? @relation(fields: [metricId], references: [id], onDelete: Restrict)
  evidence Evidence?
  reviews FactReview[] @relation("ReviewedFact")
  conflicts FactReview[] @relation("RelatedFact")
  @@index([status, createdAt])
  @@index([documentId])
  @@index([programmeId])
  @@index([universityId])
  @@index([immigrationRuleId])
  @@index([occupationId])
  // Slice 7: STORED generated full-text vector (read-only; see 20260926090000_search).
  searchVector Unsupported("tsvector")? @map("search_vector")
  @@index([searchVector], type: Gin, map: "facts_search_idx")
  @@map("facts")
}
model Evidence {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  factId String @unique @map("fact_id") @db.Uuid
  fact Fact @relation(fields: [factId], references: [id], onDelete: Restrict)
  documentId String @map("document_id") @db.Uuid
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  sourceUrl String @map("source_url")
  excerpt String
  retrievedAt DateTime @map("retrieved_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("evidence")
}
model FactReview {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  factId String @map("fact_id") @db.Uuid
  fact Fact @relation("ReviewedFact",fields: [factId], references: [id], onDelete: Restrict)
  actorId String @map("actor_id") @db.Uuid
  decision String
  note String
  relatedFactId String? @map("related_fact_id") @db.Uuid
  relatedFact Fact? @relation("RelatedFact",fields: [relatedFactId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([factId])
  @@map("fact_reviews")
}

// Slice 5 (Option A): identity-only education entities. Tuition, deadlines,
// duration and scholarships are Facts linked via programmeId/universityId, so
// they share the evidence/review/conflict workflow. Partial unique indexes on
// lower(name) (ignoring rejected rows) and created_by -> auth.users FKs live in
// the SQL migration only; Prisma cannot express them.
model University {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId       String   @map("country_id") @db.Uuid
  country         Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  name            String
  officialUrl     String   @map("official_url")
  documentId      String   @map("document_id") @db.Uuid
  document        Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  evidenceExcerpt String   @map("evidence_excerpt")
  status          String   @default("proposed")
  createdBy       String   @map("created_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  programmes      Programme[]
  facts           Fact[]
  reviews         EducationReview[]

  @@index([status, countryId])
  // Slice 7: STORED generated full-text vector (read-only; see 20260926090000_search).
  searchVector Unsupported("tsvector")? @map("search_vector")
  @@index([searchVector], type: Gin, map: "universities_search_idx")
  @@map("universities")
}

model Programme {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  universityId    String   @map("university_id") @db.Uuid
  university      University @relation(fields: [universityId], references: [id], onDelete: Restrict)
  name            String
  degreeType      String   @map("degree_type")
  field           String?
  language        String?
  officialUrl     String   @map("official_url")
  applicationUrl  String?  @map("application_url")
  documentId      String   @map("document_id") @db.Uuid
  document        Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  evidenceExcerpt String   @map("evidence_excerpt")
  status          String   @default("proposed")
  createdBy       String   @map("created_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  facts           Fact[]
  reviews         EducationReview[]

  @@index([universityId])
  @@index([status, degreeType])
  // Slice 7: STORED generated full-text vector (read-only; see 20260926090000_search).
  searchVector Unsupported("tsvector")? @map("search_vector")
  @@index([searchVector], type: Gin, map: "programmes_search_idx")
  @@map("programmes")
}

model EducationReview {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  universityId String?  @map("university_id") @db.Uuid
  university   University? @relation(fields: [universityId], references: [id], onDelete: Restrict)
  programmeId  String?  @map("programme_id") @db.Uuid
  programme    Programme? @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  actorId      String   @map("actor_id") @db.Uuid
  decision     String
  note         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("education_reviews")
}

// Slice 6a: identity-only immigration rules. Requirements are Facts linked via
// immigrationRuleId. The T1/same-country/same-origin rules, public visibility
// (verified T1 source) and partial unique index live in the SQL migration.
model ImmigrationRule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId       String   @map("country_id") @db.Uuid
  country         Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  ruleType        String   @map("rule_type")
  title           String
  officialUrl     String   @map("official_url")
  documentId      String   @map("document_id") @db.Uuid
  document        Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  evidenceExcerpt String   @map("evidence_excerpt")
  status          String   @default("proposed")
  createdBy       String   @map("created_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  facts           Fact[]
  reviews         ImmigrationRuleReview[]

  @@index([status, countryId])
  // Slice 7: STORED generated full-text vector (read-only; see 20260926090000_search).
  searchVector Unsupported("tsvector")? @map("search_vector")
  @@index([searchVector], type: Gin, map: "immigration_rules_search_idx")
  @@map("immigration_rules")
}

model ImmigrationRuleReview {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  immigrationRuleId String   @map("immigration_rule_id") @db.Uuid
  immigrationRule   ImmigrationRule @relation(fields: [immigrationRuleId], references: [id], onDelete: Restrict)
  actorId           String   @map("actor_id") @db.Uuid
  decision          String
  note              String
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([immigrationRuleId])
  @@map("immigration_rule_reviews")
}

// Slice 6b: identity-only occupations. Labour-market figures are Facts linked
// via occupationId with a referencePeriod. Partial unique index on
// (lower(name), country) and the created_by FK live in the SQL migration.
model Occupation {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  classificationSystem String?  @map("classification_system")
  classificationCode   String?  @map("classification_code")
  countryId            String?  @map("country_id") @db.Uuid
  country              Country? @relation(fields: [countryId], references: [id], onDelete: Restrict)
  documentId           String   @map("document_id") @db.Uuid
  document             Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  evidenceExcerpt      String   @map("evidence_excerpt")
  status               String   @default("proposed")
  createdBy            String   @map("created_by") @db.Uuid
  reviewedAt           DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  facts                Fact[]
  reviews              OccupationReview[]

  @@index([status, createdAt])
  // Slice 7: STORED generated full-text vector (read-only; see 20260926090000_search).
  searchVector Unsupported("tsvector")? @map("search_vector")
  @@index([searchVector], type: Gin, map: "occupations_search_idx")
  @@map("occupations")
}

model OccupationReview {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occupationId String   @map("occupation_id") @db.Uuid
  occupation   Occupation @relation(fields: [occupationId], references: [id], onDelete: Restrict)
  actorId      String   @map("actor_id") @db.Uuid
  decision     String
  note         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([occupationId])
  @@map("occupation_reviews")
}

// Slice 7: admin-curated comparison vocabulary. Definitions only, never values.
// key and category are immutable once created (enforced by save_metric).
model ComparisonMetric {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  label       String
  description String
  unitHint    String?  @map("unit_hint")
  category    String
  active      Boolean  @default(true)
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  facts       Fact[]

  @@index([category, label])
  @@map("comparison_metrics")
}
