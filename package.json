{
  "name": "nordic",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "crawler"
  ],
  "scripts": {
    "dev": "npm run dev -w @nordic/web",
    "build": "npm run build -w @nordic/web",
    "start": "npm run start -w @nordic/web",
    "lint": "npm run lint -w @nordic/web",
    "test": "npm run test -w @nordic/web",
    "db:generate": "npm run generate -w @nordic/db",
    "db:migrate:dev": "npm run migrate:dev -w @nordic/db",
    "db:migrate:deploy": "npm run migrate:deploy -w @nordic/db",
    "db:studio": "npm run studio -w @nordic/db"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "unrs-resolver@1.12.2": true
  }
}
