# Copy to .env.local; fill using the same Supabase project.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Runtime: transaction pooler for Vercel; session pooler also works for local dev.
DATABASE_URL=
# Migrations: direct PostgreSQL or session pooler URI from Supabase Connect.
DIRECT_URL=

# Server-only bearer credential for internal document ingestion, >=32 random characters.
INGESTION_API_TOKEN=

# Slice 9 crawler (crawler/ package or GitHub Actions only — never read by apps/web).
# Login role that is a member of nordic_crawler_ops ONLY (see
# docs/architecture/slice-09-crawler.md). It can call the crawler_* functions
# and nothing else; it is NOT the service-role key. Keep it out of Vercel.
CRAWLER_DATABASE_URL=
# Public page describing the bot, sent in the User-Agent so site owners can
# reach you. Must be a real page you control; empty = the GitHub repository URL.
CRAWLER_CONTACT_URL=

# Slice 10a AI extraction worker (extractor/ package or GitHub Actions only —
# never read by apps/web, never set in Vercel).
# Login role that is a member of nordic_extractor_ops ONLY
# (docs/architecture/slice-10a-ai-extraction.md). Not the service-role key.
EXTRACTOR_DATABASE_URL=
# Any OpenAI-compatible Chat Completions endpoint. Gemini (free tier):
# https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
# Exact model id from the provider, e.g. the Gemini model chosen in AI Studio.
LLM_MODEL=
# Provider API key. Secret; restrict it to the provider's API only.
LLM_API_KEY=
# Optional, 1-10 (default 5).
EXTRACTOR_MAX_DOCUMENTS=

# Workers only: Supabase root CA certificate (PEM, from Project Settings →
# Database → SSL configuration) so worker connections verify TLS. Public data,
# but stored as a GitHub secret for convenience (multi-line).
DATABASE_CA_CERT=
